{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@observatorio-ux/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@observatorio-ux/shared-types/*": ["../../packages/shared-types/src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}