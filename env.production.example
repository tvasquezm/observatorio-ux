# Copiar como .env.production y reemplazar todos los valores "change_me".
# Este archivo sirve únicamente como plantilla: no contiene secretos reales.

APP_PORT=8080

POSTGRES_USER=observatorio_ux
POSTGRES_PASSWORD=change_me_database_password
POSTGRES_DB=observatorio_ux

# Mantener usuario, contraseña y base sincronizados con las variables anteriores.
# Si la contraseña contiene caracteres especiales, deben codificarse para una URL.
DATABASE_URL=postgresql://observatorio_ux:change_me_database_password@db:5432/observatorio_ux?schema=public

JWT_SECRET=change_me_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
JWT_PARTICIPANTE_SECRET=change_me_with_a_different_32_char_secret
JWT_PARTICIPANTE_EXPIRES_IN=4h

# Debe coincidir exactamente con el origen público, incluido esquema y puerto.
CORS_ORIGIN=http://localhost:8080

# H3 (auditoría 2026-09-24): "pnpm run seed" crea datos y usuarios DEMO.
# En producción abortará si no defines estas 3 variables (evita que queden
# las contraseñas por defecto del seed en un ambiente real). Si solo
# necesitas el primer administrador, usa BOOTSTRAP_ADMIN_* + "pnpm run
# bootstrap:admin" en vez de correr el seed completo.
SEED_PASSWORD=change_me_seed_estudiantes
SEED_PROFESOR_PASSWORD=change_me_seed_profesor
SEED_ADMIN_PASSWORD=change_me_seed_admin

# "pnpm run bootstrap:admin" — crea o promueve a un solo usuario ADMIN real,
# sin datos demo. Ninguna tiene default: si falta alguna, el script no crea
# nada. BOOTSTRAP_ADMIN_PASSWORD debe tener 12+ caracteres.
BOOTSTRAP_ADMIN_EMAIL=change_me_admin_email
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password_min_12_chars
BOOTSTRAP_ADMIN_NOMBRE=Administrador
