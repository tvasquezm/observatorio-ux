# Para correr el frontend suelto (sin Docker Compose), fuera de la raíz
# del monorepo. Si usas `docker compose up`, ignora este archivo — se usa
# el `.env.example` de la raíz en su lugar.
#
# OJO: incluye el sufijo /api. El backend expone todo bajo ese prefijo
# global (app.setGlobalPrefix('api') en apps/backend/src/main.ts) — sin
# él, cada request pega 404 (ver docs/AUDIT_LOG.md, hallazgo D5).
VITE_API_URL=http://localhost:3000/api
