# ==========================
# Base de datos
# ==========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/observatorio_ux"

# ==========================
# JWT
# ==========================
JWT_SECRET="observatorio-ux-dev-secret-evaluador-min-32"
JWT_EXPIRES_IN="1h"

# Secreto distinto para participanteToken — nunca debe coincidir con JWT_SECRET.
JWT_PARTICIPANTE_SECRET="observatorio-ux-dev-secret-participante-min-32"
JWT_PARTICIPANTE_EXPIRES_IN="4h"

# ==========================
# Aplicación
# ==========================
PORT=3000

NODE_ENV=development
GOOGLE_CLIENT_ID=
# F35: dominios de Google Workspace aceptados (coma), p. ej. utem.cl. Vacío = sin restricción extra.
GOOGLE_ALLOWED_DOMAINS=
# F35: ingreso con contraseña. Vacío = activo en desarrollo y apagado en producción; true solo como respaldo de emergencia.
PASSWORD_LOGIN_ENABLED=
CORS_ORIGIN="http://localhost:5173"
