# ==========================
# Base de datos
# ==========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/observatorio_ux"

# ==========================
# JWT
# ==========================
JWT_SECRET="observatorio-ux-dev-secret"
JWT_EXPIRES_IN="1h"

JWT_PARTICIPANTE_SECRET="observatorio-ux-dev-secret-participante"
JWT_PARTICIPANTE_EXPIRES_IN="4h"

# ==========================
# Aplicación
# ==========================
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ==========================
# Google OAuth (login evaluador)
# ==========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"