// ============================================================
// OBSERVATORIO UX — schema.prisma (Kit de Arranque + 3FN Card Sorting)
// Refleja el ADR Master: modelo dual, bloqueo pesimista, consentimiento.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ESTUDIANTE
  DOCENTE
  ADMIN
}

enum TipoSesion {
  CARD_SORTING
  EVALUACION_HEURISTICA
}

enum EstadoSesion {
  INVITADO
  EN_PROGRESO
  COMPLETADO
  ABANDONADO
}

enum ActorSesion {
  PARTICIPANTE
  EVALUADOR
}

enum TipoArtefacto {
  PERSONA
  JOURNEY_MAP
  MOMENTOS_CRITICOS
}

enum TipoCardSorting {
  ABIERTO
  CERRADO
}

// ------------------------------------------------------------
// NÚCLEO
// ------------------------------------------------------------

model Proyecto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  creadoPor   Usuario  @relation("ProyectosCreados", fields: [creadoPorId], references: [id])
  creadoPorId String
  createdAt   DateTime @default(now())

  sesiones   ResearchSession[]
  artefactos UxArtifact[]
  whitelist  ParticipanteWhitelist[]
  miembros   ProyectoMiembro[]
  comentarios Comentario[]
  salaId String?
  sala   Sala?   @relation(fields: [salaId], references: [id])

  // Soft delete: se activa en cascada cuando su Sala se elimina (ver
  // Sala.deletedAt). Los listados (findAll) lo excluyen por defecto.
  deletedAt DateTime?

  @@map("proyectos")
}

model ProyectoMiembro {
  id         String   @id @default(uuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId  String
  createdAt  DateTime @default(now())

  @@unique([proyectoId, usuarioId])
  @@map("proyecto_miembros")
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  passwordHash String?
  rol       Rol
  createdAt DateTime @default(now())

  proyectosCreados  Proyecto[]        @relation("ProyectosCreados")
  sesionesEvaluador ResearchSession[] @relation("SesionesComoEvaluador")
  artefactosAutor   UxArtifact[]      @relation("ArtefactosComoAutor")
  whitelistCreada   ParticipanteWhitelist[]
  proyectosMiembro  ProyectoMiembro[]
  comentariosAutor  Comentario[]      @relation("ComentariosComoAutor")
  equiposCreados    Equipo[]          @relation("EquiposCreados")
  equiposMiembro    EquipoMiembro[]   @relation("EquiposComoMiembro")
  salas Sala[]
  @@map("usuarios")

}

model Participante {
  id        String   @id @default(uuid())
  metadata  Json? // datos demográficos opcionales, anonimizables sin perder sesiones
  createdAt DateTime @default(now())

  consentimientos Consentimiento[]
  sesiones        ResearchSession[] @relation("SesionesComoParticipante")
  categoriasCreadas Category[]
  whitelistEntries ParticipanteWhitelist[]
  @@map("participantes")
}
model ParticipanteWhitelist {
  id         String   @id @default(uuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  email      String
  nombre     String?
  usado      Boolean  @default(false)
  codigoInvitacionHash String?

  participante   Participante? @relation(fields: [participanteId], references: [id])
  participanteId String?

  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])
  creadoPorId String
  createdAt   DateTime @default(now())

  @@unique([proyectoId, email])
  @@index([proyectoId, participanteId])
  @@map("participantes_whitelist")
}

// Consentimiento informado
model Consentimiento {
  id             String       @id @default(uuid())
  participante   Participante @relation(fields: [participanteId], references: [id])
  participanteId String
  proyectoId     String
  aceptado       Boolean
  version        String
  ipRegistro     String?
  createdAt      DateTime     @default(now())

  @@map("consentimientos")
}
model Sala {
  id            String     @id @default(uuid())
  nombre        String
  periodo       String
  instrucciones String?
  fechaInicio   DateTime?
  fechaFin      DateTime?
  profesorId    String
  profesor      Usuario    @relation(fields: [profesorId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  proyectos     Proyecto[]
  estudiantes   SalaEstudiante[]
  equipos       Equipo[]

  // Fase 4: toggle de creación de equipos por ESTUDIANTE (DOCENTE dueño
  // siempre puede crear equipos, use o no este toggle). limiteIntegrantesEquipo
  // nulo = sin límite; solo lo configura el DOCENTE dueño o ADMIN.
  permiteCreacionEquipos  Boolean @default(false)
  limiteIntegrantesEquipo Int?

  // Fase 5: toggle de creación de proyectos por ESTUDIANTE (mismo patrón que
  // permiteCreacionEquipos). DOCENTE dueño/ADMIN no dependen de este flag.
  permiteCreacionProyectos Boolean @default(false)

  // Soft delete con ventana de recuperación de 20 días (ver SalasService).
  // Al eliminarse, cascada lógica a los Proyecto de la sala.
  deletedAt DateTime?
}

// Registro liviano de estudiante inscrito en una sala. No es un Usuario
// (sin login/password) — solo los datos que el profesor carga para hacer
// seguimiento dentro de la sala.
model SalaEstudiante {
  id        String   @id @default(uuid())
  sala      Sala     @relation(fields: [salaId], references: [id])
  salaId    String
  nombre    String?
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaId, email])
  @@map("sala_estudiantes")
}

// Fase 4: equipo de estudiantes dentro de una Sala. Hard delete real (no es
// evidencia de investigación como UxArtifact, no necesita ventana de
// recuperación).
model Equipo {
  id         String @id @default(uuid())
  sala       Sala   @relation(fields: [salaId], references: [id])
  salaId     String
  nombre     String
  creadoPor   Usuario @relation("EquiposCreados", fields: [creadoPorId], references: [id])
  creadoPorId String
  createdAt  DateTime @default(now())

  miembros EquipoMiembro[]

  @@map("equipos")
}

model EquipoMiembro {
  id        String   @id @default(uuid())
  equipo    Equipo   @relation(fields: [equipoId], references: [id])
  equipoId  String
  usuario   Usuario  @relation("EquiposComoMiembro", fields: [usuarioId], references: [id])
  usuarioId String
  createdAt DateTime @default(now())

  @@unique([equipoId, usuarioId])
  @@map("equipo_miembros")
}
// ------------------------------------------------------------
// GRUPO A — ResearchSession (transaccional)
// ------------------------------------------------------------

model ResearchSession {
  id         String       @id @default(uuid())
  proyecto   Proyecto     @relation(fields: [proyectoId], references: [id])
  proyectoId String
  tipo       TipoSesion
  estado     EstadoSesion @default(INVITADO)

  actor          ActorSesion
  participante   Participante? @relation("SesionesComoParticipante", fields: [participanteId], references: [id])
  participanteId String?
  evaluador      Usuario?      @relation("SesionesComoEvaluador", fields: [evaluadorId], references: [id])
  evaluadorId    String?

  resultado Json? 

  // --- NUEVO: 3FN CARD SORTING ---
  tipoCardSorting TipoCardSorting?

  // Auto-relación Evaluador -> Participante
  estudio   ResearchSession?  @relation("EstudioParticipantes", fields: [estudioId], references: [id])
  estudioId String?
  participantesDeEsteEstudio ResearchSession[] @relation("EstudioParticipantes")

  cardsDefinidas       Card[]         @relation("SessionCards")
  categoriasDefinidas  Category[]     @relation("SessionCategories")
  agrupaciones         CardGrouping[] @relation("ParticipantGroupings")

  createdAt    DateTime  @default(now())
  completadoAt DateTime?

  @@index([proyectoId, tipo])
  @@index([estudioId])
  @@map("research_sessions")
}

// ------------------------------------------------------------
// MODELOS CARD SORTING (3FN)
// ------------------------------------------------------------

model Card {
  id        String          @id @default(uuid())
  session   ResearchSession @relation("SessionCards", fields: [sessionId], references: [id])
  sessionId String
  etiqueta  String
  createdAt DateTime        @default(now())

  agrupaciones CardGrouping[]

  @@index([sessionId])
  @@map("cards")
}

model Category {
  id        String          @id @default(uuid())
  session   ResearchSession @relation("SessionCategories", fields: [sessionId], references: [id])
  sessionId String
  nombre    String

  esPredefinida Boolean @default(true)

  creadaPorParticipante   Participante? @relation(fields: [creadaPorParticipanteId], references: [id])
  creadaPorParticipanteId String?

  createdAt DateTime @default(now())

  agrupaciones CardGrouping[]

  @@index([sessionId])
  @@map("categories")
}

model CardGrouping {
  id                   String          @id @default(uuid())
  participanteSesion   ResearchSession @relation("ParticipantGroupings", fields: [participanteSesionId], references: [id])
  participanteSesionId String

  card   Card   @relation(fields: [cardId], references: [id])
  cardId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  createdAt DateTime @default(now())

  @@unique([participanteSesionId, cardId])
  @@index([categoryId, participanteSesionId])
  @@map("card_groupings")
}

// ------------------------------------------------------------
// GRUPO B — UxArtifact (versionado append-only + bloqueo pesimista)
// ------------------------------------------------------------

model UxArtifact {
  id                String        @id @default(uuid())
  proyecto          Proyecto      @relation(fields: [proyectoId], references: [id])
  proyectoId        String
  tipo              TipoArtefacto
  artefactoLogicoId String 
  version           Int           @default(1)
  contenido         Json

  autor   Usuario @relation("ArtefactosComoAutor", fields: [autorId], references: [id])
  autorId String

  createdAt DateTime @default(now())

  lockedById  String?
  lockedUntil DateTime?

  // Soft delete: proteger la cadena de evidencia del Observatorio.
  // Un artefacto "eliminado" nunca se borra de la fila; solo se marca.
  // El listado (findAll) lo excluye por defecto (deletedAt: null).
  deletedAt DateTime?

  @@unique([artefactoLogicoId, version])
  @@map("ux_artifacts")
}

model Comentario {
  id         String   @id @default(uuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String

  // Referencia al artefacto lógico (no a una fila de versión puntual), para
  // que el comentario siga siendo válido aunque el artefacto se versione.
  artefactoLogicoId String?

  autor   Usuario @relation("ComentariosComoAutor", fields: [autorId], references: [id])
  autorId String

  texto String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Soft delete: mismo patrón que Sala/Proyecto/UxArtifact.
  deletedAt DateTime?

  @@map("comentarios")
}
