            "value": "",
            "type": "string"
        },
        {
            "key": "proyectoId",
            "value": "uuid_de_tu_proyecto_aqui",
            "type": "string"
        },
        {
            "key": "artefactoLogicoId",
            "value": "",
            "type": "string"
        }
    ]
}