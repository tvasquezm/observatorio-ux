# Copiar este archivo como .env en la raíz del proyecto:
#   cp .env.example .env
# Los valores de abajo funcionan tal cual para desarrollo local con Docker.
# NO subir el .env real (con secretos de verdad) a git.

# ==== General ====
NODE_ENV=development

# ==== Backend (apps/backend) — validado por src/core/config/env.validation.ts ====
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/observatorio_ux?schema=public
JWT_SECRET=dev_only_change_me_min_16_chars
JWT_EXPIRES_IN=1h
# Nunca debe coincidir con JWT_SECRET — Regla de negocio: Segregación de Auth
# (evaluadorToken y participanteToken no comparten secreto).
JWT_PARTICIPANTE_SECRET=dev_only_change_me_participante_min_16
JWT_PARTICIPANTE_EXPIRES_IN=4h
CORS_ORIGIN=http://localhost:5173

# ==== Frontend (apps/frontend) — leído por vite.config.ts ====
VITE_API_URL=http://localhost:3000/api
