# Copiar este archivo como .env en la raíz del proyecto:
#   cp env.example .env
# Los valores de abajo funcionan tal cual para desarrollo local con Docker.
# NO subir el .env real (con secretos de verdad) a git.

# ==== General ====
NODE_ENV=development
# Opt-in: el seed modifica cuentas y proyectos demo. Mantener false al reiniciar.
SEED_ON_START=false

# ==== Backend (apps/backend) — validado por src/core/config/env.validation.ts ====
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/observatorio_ux?schema=public
JWT_SECRET=dev_only_change_me_evaluador_min_32_chars
JWT_EXPIRES_IN=1h
# Duraciones: entero positivo + s, m, h o d.
JWT_MAX_SESSION=12h
JWT_REFRESH_WINDOW=10m
# Nunca debe coincidir con JWT_SECRET — Regla de negocio: Segregación de Auth
# (evaluadorToken y participanteToken no comparten secreto).
JWT_PARTICIPANTE_SECRET=dev_only_change_me_participante_min_32_chars
JWT_PARTICIPANTE_EXPIRES_IN=4h
SEED_ADMIN_PASSWORD=admin1234
CORS_ORIGIN=http://localhost:5173
# Límite global de peticiones por IP (por defecto 60 por minuto). Solo hace falta en producción
# si muchos usuarios comparten IP; ver env.production.example.
# THROTTLE_LIMIT=60
# THROTTLE_TTL_MS=60000
# Opcional: Google Identity Services. Vacío mantiene el acceso Google desactivado.
GOOGLE_CLIENT_ID=
# F35: dominios de Google Workspace aceptados (coma), p. ej. utem.cl. Vacío = sin restricción extra.
GOOGLE_ALLOWED_DOMAINS=
# F35: ingreso con contraseña. Vacío = activo en desarrollo y apagado en producción; true solo como respaldo de emergencia.
PASSWORD_LOGIN_ENABLED=

# ==== Frontend (apps/frontend) — leído por vite.config.ts ====
VITE_API_URL=/api
# Docker Compose resuelve el servicio por su nombre. Para Vite fuera de Docker,
# usa http://localhost:3000 en el .env local.
VITE_DEV_API_PROXY_TARGET=http://backend:3000
# Video tutorial de la página de inicio (YouTube, Vimeo o archivo en public/).
# Vacío = video oficial (https://youtu.be/eEmAiAIrMbY). En Vercel va como variable del frontend.
VITE_VIDEO_TUTORIAL_URL=
